[Unit]
Description=Camera Startup Script - restart on crash
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{WORKING_DIRECTORY}}/{{FILENAME}}/code/central/camera-2/startup.sh
Restart=on-failure
RestartSec=10
StartLimitBurst=20
StartLimitIntervalSec=600
# Optional: run as specific user/group
User={{ACCOUNT_NAME}}
Group={{ACCOUNT_NAME}}
# Optional: environment file
# EnvironmentFile=/etc/default/my-script

[Install]
WantedBy=multi-user.target
