[Unit]
Description=Serre aliot-py
Wants=network-online.target bluetooth.target
After=network-online.target bluetooth.target

[Service]
Type=simple
User={{ACCOUNT_NAME}}
Group={{ACCOUNT_NAME}}
SupplementaryGroups=video,gpio,i2c,spi
WorkingDirectory={{WORKING_DIRECTORY}}/{{FILENAME}}/code/central
ExecStart={{WORKING_DIRECTORY}}/{{FILENAME}}/code/central/venv/bin/python -u {{WORKING_DIRECTORY}}/{{FILENAME}}/code/central/main.py
Restart=on-failure
RestartSec=60
StandardOutput=append:{{STANDARD_LOGS}}
StandardError=append:{{ERROR_LOGS}}

[Install]
WantedBy=multi-user.target
